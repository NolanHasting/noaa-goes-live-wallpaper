# Copy or edit ~/.config/goes-live-wallpaper/config.env after installation.
# This is a Bash config sourced locally by update.sh; do not paste untrusted code.
SATELLITE=GOES19    # GOES19: eastern Americas, GOES18: western Americas / Pacific
WIDTH=3840          # Set to your monitor's pixel width
HEIGHT=2160         # Set to your monitor's pixel height
PADDING=32          # Black margin around the full disk, in pixels
KEEP=3              # Number of historical wallpapers to retain
# DATA_DIR="$HOME/Library/Application Support/GOES Live Wallpaper"
# SCREENSAVER_DIR="$HOME/Pictures/GOES Live Wallpaper"
